export default "#ifdef GL_ES\nprecision highp float;\n#define GLSLIFY 1\n#endif\n\n// The room's last pass (Renderer.ts): the frame just drawn, copied, then drawn again with the edge vignette and the\n// film grain. It runs on the canvas's own pixels (sRGB, premultiplied alpha), so wherever the room isn't drawn yet\n// (alpha 0: the loader's paper behind the canvas, during the reveal) nothing is added, and a half faded desk gets\n// grain in proportion to how much of it shows.\n\nuniform sampler2D tFrame;\nuniform vec2 uRes;        // drawing buffer size, px\nuniform float u_time;\nuniform float uGrain;     // strength (0.35 matches the old soft-light overlay canvas; ?grain= tries others)\n\n// Hash without sine: gold noise drew visible rings over a dark scene\nfloat noise(vec2 xy, float seed) {\n  vec3 p3 = fract(vec3(xy.xyx) * 0.1031 + seed);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\n// the soft-light lightening curve (W3C compositing spec)\nvec3 softD(vec3 b) {\n  return mix(sqrt(b), ((16.0 * b - 12.0) * b + 4.0) * b, step(b, vec3(0.25)));\n}\n\nvoid main() {\n  vec4 frame = texture2D(tFrame, gl_FragCoord.xy / uRes);\n  if (frame.a <= 0.0) { gl_FragColor = vec4(0.0); return; }\n  vec3 c = clamp(frame.rgb / frame.a, 0.0, 1.0);\n\n  // vignette: as the old CSS one (an 85% ellipse, clear to 60% of the way out, 38% black at its rim)\n  vec2 uv = gl_FragCoord.xy / uRes;\n  float r = length((uv - 0.5) / 0.85);\n  c *= 1.0 - 0.38 * clamp((r - 0.6) / 0.4, 0.0, 1.0);\n\n  // grain: soft-light towards white by a random amount per pixel, measured against the old overlay canvas\n  // (it lifted and speckled the room the same way); one value for all three channels, so no colour speckle\n  float n = noise(gl_FragCoord.xy, fract(u_time) + 1.0);\n  c += uGrain * 2.0 * n * (softD(c) - c);\n\n  gl_FragColor = vec4(c * frame.a, frame.a);\n}\n";